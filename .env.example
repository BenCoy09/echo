# Prices default to Binance public data. Optional overrides:
# PRICE_API_URL=https://your.api/price      # GET ?token=SOL&at=ISO -> {"price": n}
# PRICE_SOURCE=mock                         # offline testing only
# RYO-CHAN MCP
# RYO_MCP_URL=
# RYO_MCP_KEY=
# Live collection
# ECHO_INGEST_KEY=change-me
# X_BEARER_TOKEN=
# ECHO_VOICES=handle1,handle2,handle3,handle4
# ECHO_TOKENS=SOL,ETH,LINK
# RYO-CHAN MCP (Streamable HTTP). See README "RYO-CHAN".
# RYO_MCP_URL=https://...
# RYO_MCP_KEY=
# RYO_TOOL=market_snapshot
# RYO_ARGS={"token":"{token}"}
# RYO_FIELD_MAP={"volumeChange24h":"data.vol24hChangePct","fundingPct":"data.fundingRatePct","liquidityUsd":"data.liquidity1pctUsd"}
# RYO-CHAN as used by other teams: https://app-ryochan.com/api/mcp ; key (ryo_mcp_...) comes from the organizers.
# RYO_AUTH_HEADER=authorization   # change to x-api-key if Bearer is rejected
# RYO_AUTH_SCHEME=Bearer          # set to empty to send the raw key
